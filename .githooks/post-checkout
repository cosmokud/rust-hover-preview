#!/bin/sh
# The shared cargo target dir is machine-local, so it cannot live in a committed
# file without leaking a drive letter into every clone. Instead it arrives from
# `git config rhp.targetDir` and is handed to cargo as .cargo/target-dir.local.toml,
# which .cargo/config.toml includes. Unset means this hook writes nothing and cargo
# uses the usual per-checkout target/, which is what other machines and CI get.
#
# Every checkout builds into that one dir, so a dependency is compiled once and
# stored once instead of once per worktree. Cargo's artifact and fingerprint names
# carry no part of a checkout's path, so a build here could otherwise be called
# fresh against another tree's recorded inputs and do nothing at all, leaving that
# tree's binary behind. RHP_WORKTREE is this checkout's path and `build.rs` watches
# it, so a build in a different checkout always recompiles this package — and only
# this package, which is the part that cannot be shared between checkouts anyway.

set -eu

target=$(git config --get rhp.targetDir) || exit 0
[ -n "$target" ] || exit 0

# TOML wants forward slashes; accept a path pasted from Explorer.
target=$(printf '%s' "$target" | tr '\\' '/')

# A value belongs to the system that reads it: cargo on Windows wants a drive letter and
# cargo anywhere else wants a path that starts at /, and the other shape is not a target
# dir there but a relative one — cargo would quietly build into a `D:` folder inside the
# checkout. So a value of the wrong shape for this system is left unwritten, and cargo
# falls back to the usual per-checkout target/.
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) shape=windows ;;
  *) shape=posix ;;
esac
case "$shape:$target" in
  windows:[A-Za-z]:/*) ;;
  posix:/*) ;;
  *)
    echo "rhp.targetDir is '$target', which is not a path this system can build into." >&2
    echo "Nothing written; cargo will use this checkout's own target/." >&2
    exit 0
    ;;
esac

root=$(git rev-parse --show-toplevel) || exit 0
root=$(printf '%s' "$root" | tr '\\' '/')

mkdir -p "$root/.cargo"
printf '# Written by .githooks/post-checkout. Machine-local, never committed.\n[build]\ntarget-dir = "%s"\n\n# Differs per checkout: a build in another one recompiles this package (see build.rs).\n[env]\nRHP_WORKTREE = { value = "%s", relative = false, force = true }\n' "$target" "$root" > "$root/.cargo/target-dir.local.toml"
